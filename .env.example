# Copy to .env for local development. Never commit real secrets.
ENVIRONMENT=local
LOG_LEVEL=INFO

# Runtime role: non-superuser, non-owner, subject to RLS.
DATABASE_URL=postgresql+psycopg://app_user:app_user_dev_pw@localhost:5432/app
# Schema owner, used only by Alembic.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://app_owner:app_owner_dev_pw@localhost:5432/app

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-value
SESSION_TTL_MINUTES=480
COOKIE_SECURE=false

BCRYPT_ROUNDS=12
LOCKOUT_THRESHOLD=5
LOCKOUT_MINUTES=15

# Connection pool (use DB_POOL_SIZE=3 DB_MAX_OVERFLOW=2 on a free-tier managed Postgres).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=300
COOKIE_SAMESITE=lax

# Public demo only: per-IP login throttling, rate limits, GET /demo/info, reset-demo.
DEMO_MODE=false
DEMO_LOCKOUT_SECONDS=60
# RATE_LIMIT_ENABLED defaults to DEMO_MODE.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_WRITES_PER_MINUTE=60
